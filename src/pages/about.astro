---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import Container from "../components/Container.astro";
import { getLangFromUrl, useTranslations } from "../i18n/ui";
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<BaseLayout
  title="About | Aurora Laboratories"
  description="About Adam, a software developer in northern Sweden."
>
  <Section border={false}>
    <Container>
      <div>
        <h1 class="font-serif text-5xl leading-tight text-ink lg:text-7xl">About</h1>
        <p class="mt-6 text-lg text-ink-muted lg:text-xl">
          {t("about.intro1")}
        </p>
        <p class="mt-6 text-lg text-ink-muted lg:text-xl">
          {t("about.intro2")}
        </p>
        <p class="mt-6 text-lg text-ink-muted lg:text-xl">
          {t("about.intro3")}
        </p>
      </div>
    </Container>
  </Section>
</BaseLayout>
