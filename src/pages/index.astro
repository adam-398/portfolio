---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Aurora Laboratories"
  description="Native apps and web tools built in northern Sweden"
>
  <section class="border-b border-line px-6 py-16 sm:px-10 md:py-24 lg:px-16 2xl:py-32">
    <div
      class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-2 lg:items-end 2xl:max-w-7xl"
    >
      <div>
        <p class="mb-6 text-sm text-ink-muted 2xl:text-base">
          Software studio in northern Sweden
        </p>

        <h1
          class="max-w-3xl font-serif text-5xl leading-tight lg:text-7xl xl:text-8xl 2xl:max-w-4xl"
        >
          Native apps and web tools, <em>made for you</em>
        </h1>
      </div>

      <div class="max-w-sm lg:justify-self-end 2xl:max-w-md">
        <p class="mb-8 text-lg leading-relaxed text-ink-muted 2xl:text-xl">
          I design and build native mobile apps and web tools for small
          businesses, from first sketch and database design to launch and beyond.
        </p>
        <a
          href="#contact"
          class="inline-block bg-ink px-6 py-3 font-medium text-paper 2xl:px-8 2xl:py-4"
        >
          Get in touch
        </a>
      </div>
    </div>
  </section>
</BaseLayout>