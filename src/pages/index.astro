---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import Container from "../components/Container.astro";
import LaptopWithPhone from "../components/LaptopWithPhone.astro";
import AppCard from "../components/AppCard.astro";
import trailWeightShot from "../assets/screenshots/trail-weight-hero.png";
import waymarkShot from "../assets/screenshots/waymark-hero.png";
import fiveCutShot from "../assets/screenshots/five-cut-hero.png";
---

<BaseLayout
  title="Aurora Laboratories"
  description="Native apps and web tools built in northern Sweden"
>
  <!-- Hero -->
  <Section spacing="large">
    <Container>
      <div class="grid gap-10 lg:grid-cols-2 lg:items-end">
        <div>
          <p class="mb-6 text-sm text-ink-muted 2xl:text-base">
            Software studio in northern Sweden
          </p>

          <h1 class="max-w-3xl font-serif text-5xl leading-tight lg:text-7xl xl:text-8xl 2xl:max-w-4xl">
            Mobile apps and web tools,<em>made for you</em>
          </h1>
        </div>

        <div class="max-w-sm lg:justify-self-end 2xl:max-w-md">
          <p class="mb-8 text-lg leading-relaxed text-ink-muted 2xl:text-xl">
            Designing and building native mobile apps and web tools for small businesses, from first
            sketch and database design to launch and beyond.
          </p>
          <a
            href="/contact/"
            class="inline-block bg-ink px-6 py-3 font-medium text-paper 2xl:px-8 2xl:py-4"
          >
            Get in touch
          </a>
        </div>
      </div>
    </Container>
  </Section>

  <!-- Featured project -->
  <Section>
    <Container>
      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div>
          <p class="mb-6 flex items-center gap-4 text-sm 2xl:text-base">
            <span class="text-ink-muted">Featured project</span>
            <span class="flex items-center gap-2">
              <span class="size-2 bg-accent" aria-hidden="true"></span>
              In development
            </span>
          </p>

          <h2 class="font-serif text-5xl leading-tight lg:text-6xl 2xl:text-7xl">Counted</h2>
          <p class="mb-6 font-serif text-2xl italic text-ink-muted lg:text-3xl 2xl:text-4xl">
            Ditch the clipboard and count stock in minutes.
          </p>
          <p class="mb-8 max-w-md text-lg leading-relaxed text-ink-muted 2xl:max-w-lg 2xl:text-xl">
            A stocktaking app for independent cafés, bars and restaurants. Set it up on your
            computer, count on your phone, even without signal, and finish with your order list
            ready.
          </p>
          <a
            href="/contact/"
            class="text-lg underline decoration-accent underline-offset-8 2xl:text-xl"
          >
            Ask about early access
          </a>
        </div>
        <LaptopWithPhone />
      </div>
    </Container>
  </Section>

  <!-- App overview -->
  <Section>
    <Container>
      <h2 class="mb-12 font-serif text-5xl leading-tight lg:text-6xl 2xl:text-7xl">Mobile apps</h2>
      <div class="grid gap-12 sm:grid-cols-2 lg:grid-cols-3">
        <AppCard
          name="Trail Weight"
          description="Track the weight of your hiking gear."
          status="Live on Google Play"
          tech={["Kotlin", "Jetpack Compose", "Supabase"]}
          image={trailWeightShot}
          imageAlt="Trail Weight showing a pie chart of a 5 kg Kungsleden pack, broken down by gear category"
        />
        <AppCard
          name="Waymark"
          description="Offline-first hiking for Sweden."
          status="Coming early 2027"
          tech={["Kotlin", "Jetpack Compose", "Supabase", "MapLibre", "Room"]}
          image={waymarkShot}
          imageAlt="Waymark showing a topographic map of Norrbotten with a hiking route and saved pins"
        />
        <AppCard
          name="Woodworking calculator"
          description="5 cut method for woodworkers."
          status="Coming soon"
          tech={["Kotlin", "Jetpack Compose"]}
          image={fiveCutShot}
          imageAlt="Woodworking helper showing the five-cut method calculator with a fence adjustment result"
        />
      </div>
    </Container>
  </Section>
</BaseLayout>
