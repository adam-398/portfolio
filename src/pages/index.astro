---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import Container from "../components/Container.astro";
import LaptopWithPhone from "../components/LaptopWithPhone.astro";
import AppCard from "../components/AppCard.astro";
import trailWeightShot from "../assets/screenshots/trail-weight-hero.png";
import waymarkShot from "../assets/screenshots/waymark-hero.png";
import fiveCutShot from "../assets/screenshots/five-cut-hero.png";
import countedLaptopShot from "../assets/screenshots/stocktake-laptop-hero.png";
import countedPhoneShot from "../assets/screenshots/stocktake-phone-hero.png";
import myPhoto2 from "../assets/my-photo-2.png";
import { getLangFromUrl, useTranslations } from "../i18n/ui";
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<BaseLayout
  title="Aurora Laboratories"
  description="Native apps, websites and web tools built in northern Sweden"
>
  <!-- Hero -->
  <Section spacing="large">
    <Container>
      <div class="grid gap-10 lg:grid-cols-2 lg:items-end">
        <div>
          <p class="mb-6 text-sm text-ink-muted 2xl:text-base">{t("index.title1")}</p>

          <h1 class="max-w-3xl font-serif text-5xl leading-tight lg:text-7xl xl:text-8xl 2xl:max-w-4xl">
            {t("index.title2")} <em>{t("index.title2Emphasis")}</em>
          </h1>
        </div>

        <div class="max-w-sm lg:justify-self-end 2xl:max-w-md">
          <p class="mb-8 text-lg leading-relaxed text-ink-muted 2xl:text-xl">{t("index.intro")}</p>
          <a
            href="/contact/"
            class="inline-block bg-ink px-6 py-3 font-medium text-paper 2xl:px-8 2xl:py-4"
          >
            {t("index.intro.button")}
          </a>
        </div>
      </div>
    </Container>
  </Section>

  <!-- Featured project -->
  <Section>
    <Container>
      <div class="grid items-center gap-12 lg:grid-cols-[2fr_3fr]">
        <div>
          <p class="mb-6 flex items-center gap-4 text-sm 2xl:text-base">
            <span class="text-ink-muted">{t("index.featuredproject.title1")}</span>
            <span class="flex items-center gap-2">
              <span class="size-2 bg-accent" aria-hidden="true"></span>
              {t("index.featuredproject.title2")}
            </span>
          </p>

          <h2 class="font-serif text-5xl leading-tight lg:text-6xl 2xl:text-7xl">
            {t("index.featuredproject.title3")}
          </h2>
          <p class="mb-6 font-serif text-2xl italic text-ink-muted lg:text-3xl 2xl:text-4xl">
            {t("index.featuredproject.subtitle")}
          </p>
          <p class="mb-8 max-w-md text-lg leading-relaxed text-ink-muted 2xl:max-w-lg 2xl:text-xl">
            {t("index.featuredproject.description")}
          </p>
          <a
            href="/contact/"
            class="text-lg underline decoration-accent underline-offset-8 2xl:text-xl"
          >
            {t("index.featuredproject.cta")}
          </a>
        </div>
        <LaptopWithPhone
          laptop={countedLaptopShot}
          laptopAlt="Counted dashboard showing a stocktake in progress, with counts for each storage area"
          phone={countedPhoneShot}
          phoneAlt="Counting stock on the Counted phone app, with plus and minus buttons for each product"
        />
      </div>
    </Container>
  </Section>

  <!-- App overview -->
  <Section>
    <Container>
      <h2 class="mb-12 font-serif text-5xl leading-tight lg:text-6xl 2xl:text-7xl">
        {t("index.mobileapps.title")}
      </h2>
      <div class="grid gap-12 sm:grid-cols-2 lg:grid-cols-3">
        <AppCard
          name={t("index.mobileapps.trailweight.title")}
          description={t("index.mobileapps.trailweight.description")}
          status={t("index.mobileapps.trailweight.status")}
          tech={t("index.mobileapps.trailweight.tech").split(", ")}
          image={trailWeightShot}
          imageAlt={t("index.mobileapps.trailweight.imageAlt")}
        />
        <AppCard
          name={t("index.mobileapps.waymark.title")}
          description={t("index.mobileapps.waymark.description")}
          status={t("index.mobileapps.waymark.status")}
          tech={t("index.mobileapps.waymark.tech").split(", ")}
          image={waymarkShot}
          imageAlt={t("index.mobileapps.waymark.imagealt")}
        />
        <AppCard
          name={t("index.mobileapps.woodworking.title")}
          description={t("index.mobileapps.woodworking.description")}
          status={t("index.mobileapps.woodworking.status")}
          tech={t("index.mobileapps.woodworking.tech").split(", ")}
          image={fiveCutShot}
          imageAlt="Woodworking helper showing the five-cut method calculator with a fence adjustment result"
        />
      </div>
    </Container>
  </Section>

  <!-- About me -->
  <Section>
    <Container>
      <div class="grid gap-12 lg:grid-cols-[2fr_3fr]">
        <Image
          src={myPhoto2}
          alt={t("index.aboutme.alttext")}
          widths={[384, 768]}
          sizes="384px"
          class="aspect-[4/5] w-full max-w-sm object-cover"
        />
        <div>
          <h2 class="mb-6 font-serif text-5xl leading-tight lg:text-6xl 2xl:text-7xl">
            {t("index.aboutme.title")}
          </h2>
          <p class="mb-8 max-w-md text-lg leading-relaxed text-ink-muted 2xl:max-w-lg 2xl:text-xl">
            {t("index.aboutme.description")}
          </p>
          <a
            href="/about/"
            class="text-lg underline decoration-accent underline-offset-8 2xl:text-xl"
          >
            {t("index.aboutme.cta")}
          </a>
        </div>
      </div>
    </Container>
  </Section>

  <!-- Contact -->
  <Section>
    <Container>
      <div class="grid gap-12 lg:grid-cols-2">
        <h2 class="font-serif text-5xl leading-tight lg:text-6xl 2xl:text-7xl">
          {t("index.getintouch.title")}
        </h2>
        <div>
          <p class="mb-8 max-w-md text-lg leading-relaxed text-ink-muted 2xl:max-w-lg 2xl:text-xl">
            {t("index.getintouch.description")}
          </p>
          <a
            href="/contact/"
            class="inline-block bg-ink px-6 py-3 font-medium text-paper 2xl:px-8 2xl:py-4"
          >
            {t("index.getintouch.cta")}
          </a>
        </div>
      </div>
    </Container>
  </Section>
</BaseLayout>
