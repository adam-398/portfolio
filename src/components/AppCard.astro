---
import PhoneFrame from "./PhoneFrame.astro";
import type { ImageMetadata } from "astro";

interface Props {
  name: string;
  description: string;
  status: string;
  tech: string[];
  image?: ImageMetadata;
  imageAlt?: string;
}

const { name, description, status, tech, image, imageAlt } = Astro.props;
---

<article class="flex items-start gap-6 sm:block">
  <PhoneFrame class="w-28 shrink-0 sm:mb-8 sm:w-44 lg:w-48 2xl:w-56" image={image} alt={imageAlt} />

  <div>
    <h3 class="mb-3 text-xl font-medium">{name}</h3>
    <p class="mb-4 text-lg text-ink-muted">{description}</p>

    <p class="mb-3 flex items-center gap-2 text-sm">
      <span class="size-2 bg-accent" aria-hidden="true"></span>
      {status}
    </p>

    <p class="text-sm text-ink-muted">{tech.join(", ")}</p>
  </div>
</article>
