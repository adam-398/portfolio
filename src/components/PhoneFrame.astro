---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  class?: string;
  image?: ImageMetadata;
  alt?: string;
}

const { class: className, image, alt = "" } = Astro.props;
---

<div
  class:list={["aspect-[9/19] rounded-[1.25rem] border border-ink/40 bg-paper p-1.5", className]}
>
  {image ? (
    <Image
      src={image}
      alt={alt}
      widths={[240, 480]}
      sizes="224px"
      class="h-full w-full rounded-[0.9rem] object-cover object-top"
    />
  ) : (
    <div class="flex h-full items-center justify-center rounded-[0.9rem] bg-ink/5 font-mono text-xs text-ink-muted">
      screenshot
    </div>
  )}
</div>
