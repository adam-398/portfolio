---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import PhoneFrame from "./PhoneFrame.astro";

interface Props {
  laptop?: ImageMetadata;
  laptopAlt?: string;
  phone?: ImageMetadata;
  phoneAlt?: string;
}

const { laptop, laptopAlt = "", phone, phoneAlt = "" } = Astro.props;
---

<div class="relative mx-auto w-full max-w-xl pr-8 pb-8 lg:max-w-none">
  <!-- Laptop -->
  <div>
    <div class="mx-[6%] aspect-[16/10] rounded-t-xl border border-ink/40 p-2">
      {laptop ? (
        <Image
          src={laptop}
          alt={laptopAlt}
          widths={[640, 1280]}
          sizes="640px"
          class="h-full w-full rounded-md object-cover object-top"
        />
      ) : (
        <div class="flex h-full items-center justify-center rounded-md bg-ink/5 font-mono text-xs text-ink-muted">
          screenshot
        </div>
      )}
    </div>
    <div class="h-3 rounded-b-xl border border-ink/40 bg-paper-raised"></div>
  </div>

  <!-- Phone -->
  <PhoneFrame
    class="absolute right-0 bottom-0 w-28 sm:w-32 lg:w-40 2xl:w-44"
    image={phone}
    alt={phoneAlt}
  />
</div>
