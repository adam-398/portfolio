---
interface Props {
  id?: string;
  spacing?: "tight" | "normal" | "large";
  border?: boolean;
}

const { id, spacing = "normal", border = true } = Astro.props;

const spacingClasses = {
  tight: "py-8 md:py-12 2xl:py-16",
  normal: "py-16 md:py-24 2xl:py-32",
  large: "py-16 md:py-24 xl:py-32 2xl:py-48",
};
---

<section
  id={id}
  class:list={[
    "px-6 sm:px-10 lg:px-16",
    spacingClasses[spacing],
    { "border-b border-line": border },
  ]}
>
  <slot />
</section>