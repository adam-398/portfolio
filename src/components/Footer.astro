---
import Container from "./Container.astro";
import { getLangFromUrl, useTranslations } from "../i18n/ui";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const year = new Date().getFullYear();

function getLocalizedPath(path: string) {
  const cleanPath = path === "/" ? "" : path;
  return lang === "sv" ? `/sv${cleanPath}` : cleanPath || "/";
}

const links = [
  { href: getLocalizedPath("/projects/"), label: t("footer.nav.projects") },
  { href: getLocalizedPath("/about/"), label: t("footer.nav.about") },
  { href: getLocalizedPath("/contact/"), label: t("footer.nav.contact") },
];
---

<footer class="border-t border-line px-6 py-8 text-sm sm:px-10 lg:px-16">
  <Container>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      <!-- About -->
      <div>
        <p class="mb-3 font-medium">Adam Hodges</p>
        <p class="text-ink-muted">{t("footer.role")}</p>
      </div>

      <!-- Footer navigation -->
      <nav aria-label="Footer">
        <ul class="flex flex-wrap gap-x-6">
          {
            links.map((link) => (
              <li>
                <a href={link.href} class="inline-block py-2 underline-offset-4 hover:underline">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <!-- Contact -->
      <div class="flex flex-col items-start">
        <a
          href="mailto:contact@auroralaboratories.dev"
          class="inline-block py-2 underline underline-offset-4"
        >
          contact@auroralaboratories.dev
        </a>
        <a
          href="https://github.com/adam-398"
          class="inline-block py-2 underline underline-offset-4"
          target="_blank"
          rel="noopener noreferrer"
        >
          GitHub
        </a>
      </div>
    </div>

    <p class="mt-8 text-ink-muted">© {year} Adam Hodges</p>
  </Container>
</footer>