---
import { getLangFromUrl, useTranslations } from "../i18n/ui";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const currentPath = Astro.url.pathname;

// Helper to prefix internal links based on the active language
function getLocalizedPath(path: string) {
  const cleanPath = path === "/" ? "" : path;
  return lang === "sv" ? `/sv${cleanPath}` : cleanPath || "/";
}

const links = [
  { href: getLocalizedPath("/projects"), label: lang === "sv" ? "Projekt" : "Projects" },
  { href: getLocalizedPath("/about"), label: lang === "sv" ? "Om" : "About" },
  { href: getLocalizedPath("/contact"), label: lang === "sv" ? "Kontakt" : "Contact" },
];

// Helper to switch language while preserving the current page path
function getLanguageSwitchPath(targetLang: "en" | "sv") {
  // Strip out /sv prefix if present to get the clean base path
  let base = currentPath.startsWith("/sv") ? currentPath.slice(3) : currentPath;
  if (base === "") base = "/";

  return targetLang === "sv" ? `/sv${base === "/" ? "" : base}` : base;
}

const homeHref = lang === "sv" ? "/sv/" : "/";
const isHomeCurrent = currentPath === homeHref || currentPath === (lang === "sv" ? "/sv" : "/");
---

<header class="px-6 py-3 sm:px-10 lg:px-16">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-10 gap-y-4 2xl:max-w-7xl">
    <a href={homeHref} class="flex items-center gap-3 font-medium">
      <span class="size-2.5 bg-accent" aria-hidden="true"></span>
      Aurora Laboratories
    </a>

    <nav aria-label="Main" class="order-last w-full md:order-none md:w-auto">
      <ul class="flex gap-6 text-sm">
        {links.map((link) => {
          // Normalize trailing slashes for active state comparison
          const normalize = (p: string) => p.replace(/\/$/, "") || "/";
          const isCurrent = normalize(currentPath) === normalize(link.href);
          return (
            <li>
              <a
                href={link.href}
                aria-current={isCurrent ? "page" : undefined}
                class:list={[
                  "inline-block py-3 underline-offset-4 hover:underline",
                  { underline: isCurrent },
                ]}
              >
                {link.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <div class="ml-auto flex gap-2 text-sm">
      <a
        href={getLanguageSwitchPath("en")}
        aria-current={lang === "en" ? "page" : undefined}
        class:list={[
          "inline-block px-1 py-3 underline-offset-4 hover:underline",
          lang === "en" ? "underline" : "text-ink-muted",
        ]}
      >
        EN
      </a>
      <a
        href={getLanguageSwitchPath("sv")}
        aria-current={lang === "sv" ? "page" : undefined}
        class:list={[
          "inline-block px-1 py-3 underline-offset-4 hover:underline",
          lang === "sv" ? "underline" : "text-ink-muted",
        ]}
      >
        SV
      </a>
    </div>
  </div>
</header>
