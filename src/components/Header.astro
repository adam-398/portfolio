---
const links = [
  { href: "/projects", label: "Projects" },
  { href: "/about", label: "About" },
  { href: "/contact", label: "Contact" },
];

const currentPath = Astro.url.pathname;
---

<header class="px-6 py-3 sm:px-10 lg:px-16">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-10 gap-y-4 2xl:max-w-7xl">
    <a href="/" class="flex items-center gap-3 font-medium">
      <span class="size-2.5 bg-accent" aria-hidden="true"></span>
      Aurora Laboratories
    </a>

    <nav aria-label="Main" class="order-last w-full md:order-none md:w-auto">
      <ul class="flex gap-6 text-sm">
        {links.map((link) => {
          const isCurrent = currentPath === link.href;
          return (
            <li>
              <a
                href={link.href}
                aria-current={isCurrent ? "page" : undefined}
                class:list={["inline-block py-3 underline-offset-4 hover:underline", { underline: isCurrent }]}
              >
                {link.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <div class="ml-auto flex gap-2 text-sm">
      <a href="/" aria-current="page" class="inline-block px-1 py-3 underline underline-offset-4">EN</a>
      <a href="/sv/" class="inline-block px-1 py-3 text-ink-muted">SV</a>
    </div>
  </div>
</header>
